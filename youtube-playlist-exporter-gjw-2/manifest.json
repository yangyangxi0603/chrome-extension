{
  "manifest_version": 3,

  "name": "YouTube Playlist URL Exporter",

  "version": "1.1",

  "description": "导出和复制 YouTube 播放列表 URL",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  }
}